# FastAPI Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Atlas Configuration
# Provide your actual MongoDB Atlas connection string (e.g., mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=interviewiq

# Groq Cloud API Configuration
# Provide your Groq Cloud API key
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# Authentication & Security
JWT_SECRET=your_32_character_jwt_secret_key_here

# Code Execution Sandbox Configuration
# Supported providers: "auto" (default: tries local compilers -> Piston -> Judge0), "piston", "judge0", "local"
CODE_EXECUTION_PROVIDER=auto

# Self-hosted or authenticated Piston instance (Public emkc.org is whitelist-only since Feb 2026)
# If using a self-hosted or dedicated instance, set the URL and optional key:
PISTON_API_URL=
PISTON_API_KEY=

# Judge0 CE / RapidAPI configuration (Alternative cloud execution provider)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com/submissions?wait=true&base64_encoded=false
JUDGE0_API_KEY=
JUDGE0_HOST=judge0-ce.p.rapidapi.com
